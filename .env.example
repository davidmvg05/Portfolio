# Web3Forms API Access Key
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Cloudflare Turnstile Site Key (Get from https://dash.cloudflare.com/ -> Turnstile)
# For testing/dev you can use Cloudflare's always-pass test key: 1x00000000000000000000AA
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key_here
